package com.get_tt_right.accounts.query.projection;

import com.get_tt_right.accounts.command.event.AccountCreatedEvent;
import com.get_tt_right.accounts.command.event.AccountDeletedEvent;
import com.get_tt_right.accounts.command.event.AccountUpdatedEvent;
import com.get_tt_right.accounts.entity.Accounts;
import com.get_tt_right.accounts.service.IAccountsService;
import com.get_tt_right.common.event.AccntMobNumRollbackedEvent;
import com.get_tt_right.common.event.AccntMobileNumUpdatedEvent;
import com.get_tt_right.common.event.CardMobNumRollbackedEvent;
import com.get_tt_right.common.event.CusMobNumUpdatedEvent;
import lombok.RequiredArgsConstructor;
import org.axonframework.config.ProcessingGroup;
import org.axonframework.eventhandling.EventHandler;
import org.springframework.beans.BeanUtils;
import org.springframework.stereotype.Component;

/** Inside this class as you know we need to write all the logic that is responsible to handle the events that are being published from the command side.
 * We are going to have some CE's because we are yet to make some changes to the IAccountsService interface, and it's respective impl class. For now, you can ignore the CE's as they will be automatically resolved once all the changes are in place as we are following the Read Me.
 *
 * Orchestration Saga Pattern impl for update mobile number Saga flow.
 * --------------------------------------------------------------------
 * Here, just like how we have the existing event handler methods, very similarly I am going to create one more event handler method by just copying and pasting one of the existing i.e., the delete one and modifying it to handle the CusMobNumUpdatedEvent. And even simpler haha!, just copy the code from the customer projection class as it is the same thing that we have already done.
 * */
@Component
@RequiredArgsConstructor
@ProcessingGroup("account-group")
public class AccountProjection {
    private final IAccountsService iAccountsService;

    @EventHandler
    public void on(AccountCreatedEvent event) {
        Accounts accountEntity = new Accounts();
        BeanUtils.copyProperties(event, accountEntity);
        iAccountsService.createAccount(accountEntity);
    }

    @EventHandler
    public void on(AccountUpdatedEvent event) {
        iAccountsService.updateAccount(event);
    }

    @EventHandler
    public void on(AccountDeletedEvent event) {
        iAccountsService.deleteAccount(event.getAccountNumber());
    }

    /** This Event handler method is going to handle the AccntMobileNumUpdatedEvent. Once I accepted this event object inside this method, I need to invoke the method available inside the iAccountsService interface - but as of now, I am yet to define any method which is going to support updating the mobile number. That's why inside the ICustomerService, define a new abstract method with the signature boolean updateMobileNumber(String oldMobileNumber, String newMobileNumber);
     * This is going to accept the old mobile number and the new mobile number as input parameters and then return boolean indicating if the update of mobile number is successful or not. The same we want to invoke inside this event handler method. Check the AccountServiceImpl class for the implementation of the abstract method.
     * */
    @EventHandler
    public void on(AccntMobileNumUpdatedEvent accntMobileNumUpdatedEvent) {
        iAccountsService.updateMobileNumber(accntMobileNumUpdatedEvent.getMobileNumber(), accntMobileNumUpdatedEvent.getNewMobileNumber());
    }

    /** Here we are invoking the updateMobileNumber method of the IAccountsService interface, but we need to swap the mobile numbers. In the actual successful event above we passed the old mobile number as the first argument and the new mobile number as the second argument. In the rollback/compensation scenario we need to swap the mobile numbers becuase we are trying to revert the changes.
     * 1st we need to pass the new mobile number as the first argument (Which is already saved into the DB) and the old mobile number as the second argument
     * With the logic that we have written in the Accounts ms, haha!, the compensation txn is going to be executed. Once the compensation txn on the Accounts ms is completed, we need to trigger the compensation txn on the Customers ms. That's why to make it happen, we need to go to the Saga manager and we need to create a new Saga event handler method which is going to handle the event of type AccountMobNumRollbackedEvent. Check out the SagaManager class for more details
     * */
    @EventHandler
    public void on(AccntMobNumRollbackedEvent accntMobNumRollbackedEvent) {
        iAccountsService.updateMobileNumber(accntMobNumRollbackedEvent.getNewMobileNumber(), accntMobNumRollbackedEvent.getMobileNumber());
    }
}
